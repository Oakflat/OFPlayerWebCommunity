# OFPlayer — environment variable template
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.

# ── Telemetry (Umami Analytics) ──────────────────────────────────────────────
# Leave both variables empty (or remove them) to disable telemetry entirely.
# The app will still build and run normally; telemetry becomes a silent no-op.
#
# VITE_UMAMI_URL        Your self-hosted Umami instance, e.g. https://analytics.example.com
# VITE_UMAMI_WEBSITE_ID The UUID shown in Umami → Settings → Websites

VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=

# ── OFPlayer backend API ─────────────────────────────────────────────────────
# Used by /download to fetch the latest Windows release and request a short
# lived download ticket. The production default in code is https://api.ofplayer.org
# for the separated frontend/backend deployment.
#
# Local default in dev code path: http://localhost:8080
VITE_OFPLAYER_API_BASE_URL=https://api.ofplayer.org
