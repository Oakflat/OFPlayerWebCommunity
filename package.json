{
  "name": "ofplayer-community-web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"tests/**/*.js\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-vue": "^10.1.0",
    "eslint-plugin-vue-scoped-css": "^2.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@unhead/vue": "^3.1.0",
    "dompurify": "^3.4.2",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "music-metadata": "^11.12.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ],
    "tests/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
